{
  "expo": {
    "name": "HØmy",
    "slug": "homy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "homy",
    "android": {
      "package": "com.homy.customer",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HØmy to use your location for delivery."
        }
      ]
    ]
  }
}
